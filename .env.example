# Copy this file to .env and fill in real values:
#   cp .env.example .env
# The orchestrator boots without any of these, but it can only complete an
# incident when the three REQUIRED values are set. Check with:
#   curl http://localhost:8000/ready

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# LLM provider for the Triager, Investigator, Fix Authors and Releaser.
OPENAI_API_KEY=

# GitHub PAT with `repo` scope. Reads source and opens PRs.
GITHUB_TOKEN=
# The victim repo the agents read from and open PRs against (owner/repo).
# Do NOT point this at a production repository.
GITHUB_REPO=owner/repo

# ---------------------------------------------------------------------------
# OPTIONAL integrations — leave blank to disable
# ---------------------------------------------------------------------------

# Web search for the Investigator (Tavily).
TAVILY_API_KEY=

# Slack incoming webhook; the Releaser posts here when a PR opens.
SLACK_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Orchestrator runtime
# ---------------------------------------------------------------------------

# SQLModel database URL.
DATABASE_URL=sqlite:///./sre.db

# Max incident pipelines running at once; extra alerts queue up.
MAX_CONCURRENT_INCIDENTS=4

# Hard cap on Investigator tool calls per incident.
INVESTIGATOR_MAX_TOOL_CALLS=5

# ---------------------------------------------------------------------------
# Tracing (Omium) — every span is also written to local JSONL regardless
# ---------------------------------------------------------------------------

# Set to ship spans to Omium. OMIUM_PROJECT must match [project].name in
# omium.toml (or the project created via `omium project push`).
OMIUM_API_KEY=
OMIUM_PROJECT=autonomous-sre
# Override the Omium ingest URL (rarely needed).
OMIUM_API_BASE=

# auto  = try Omium, fall back to local JSONL on any error (default)
# omium = Omium only; fail loudly
# local = never touch the Omium SDK
TRACE_BACKEND=auto
LOCAL_TRACE_PATH=orchestrator/.local_traces.jsonl

# ---------------------------------------------------------------------------
# Victim app (read by victim_app/, not the orchestrator)
# ---------------------------------------------------------------------------

# none | null_deref | regression | config_error
BUG_MODE=none
ORCHESTRATOR_WEBHOOK_URL=http://localhost:8000/webhooks/alert
